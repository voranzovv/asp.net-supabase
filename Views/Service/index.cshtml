@model List<Service>

@{
    ViewData["Title"] = "Services";
}
@* create client *@

<a asp-action="Create" class="btn btn-primary">Create Service</a>
<br />
<br />

<table class="table table-striped table-bordered table-hover">
    <thead class="thead-dark">
    <tr class="text-center">
        <th>Name</th>
        <th>Price</th>
        <th>Description</th>
        <th>Action</th>
    </tr>
    </thead>
    @foreach (var service in Model)
    {
        <tr>
            <td>@service.Name</td>
            <td>@service.Price</td>
            <td>@service.Description</td>
            <td>
                @* edit button  *@
                <a class="btn btn-warning " asp-action="Edit" asp-route-id="@service.Id">Edit</a>
                @* delete button  *@
                <form asp-action="Delete" asp-route-id="@service.Id" method="post" style="display:inline;">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
                <a class="btn btn-success " asp-action="Detail" asp-route-id="@service.Id">Detail</a>

                
            </td>
        </tr>


    }

</table>